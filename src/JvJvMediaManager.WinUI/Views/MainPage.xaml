<Page
    x:Class="JvJvMediaManager.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mainPage="using:JvJvMediaManager.Views.MainPageParts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition />
        </TransitionCollection>
    </Page.Transitions>

    <Grid x:Name="RootLayoutHost"
          Padding="{ThemeResource PageOuterPadding}">
        <ContentControl x:Name="KeyboardFocusHost"
                        Width="1"
                        Height="1"
                        Opacity="0"
                        IsTabStop="True"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        TabNavigation="Local" />
        <Rectangle Fill="{ThemeResource HeroPanelBrush}"
                   IsHitTestVisible="False" />
        <SplitView x:Name="LibrarySplitViewHost"
                   DisplayMode="CompactInline"
                   IsPaneOpen="{x:Bind Library.IsLibraryPaneOpen, Mode=TwoWay}"
                   CompactPaneLength="56"
                   OpenPaneLength="{x:Bind Library.LibraryPaneWidth, Mode=TwoWay}"
                   Background="Transparent">
            <SplitView.Pane>
                <mainPage:LibraryPaneView x:Name="LibraryPaneHost"
                                          DataContext="{x:Bind Library}" />
            </SplitView.Pane>

            <SplitView.Content>
                <Grid x:Name="PlayerDockHost" AllowDrop="True" DragOver="PlayerDockHost_DragOver" DragLeave="PlayerDockHost_DragLeave" Drop="PlayerDockHost_Drop">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="DockSplitterColumn" Width="0" />
                        <ColumnDefinition x:Name="DockedPlayerColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <mainPage:PlayerPaneView x:Name="PlayerPaneHost"
                                             DataContext="{x:Bind Player}" />
                    <Border x:Name="DockSplitter"
                            Grid.Column="1"
                            Width="5"
                            Background="#40FFFFFF"
                            PointerPressed="DockSplitter_PointerPressed"
                            PointerMoved="DockSplitter_PointerMoved"
                            PointerReleased="DockSplitter_PointerReleased"
                            PointerCaptureLost="DockSplitter_PointerCaptureLost"
                            Visibility="Collapsed" />
                    <Border x:Name="DockedPlayerBorder"
                            Grid.Column="2"
                            BorderBrush="#FFFF9F1C"
                            BorderThickness="1,0,0,0"
                            Visibility="Collapsed">
                        <mainPage:DockedMediaSessionView x:Name="DockedPlayerHost" />
                    </Border>
                    <Border x:Name="DockPreview"
                            Grid.Column="2"
                            Background="#33FF9F1C"
                            BorderBrush="#FFFF9F1C"
                            BorderThickness="2"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                </Grid>
            </SplitView.Content>
        </SplitView>
        <Button x:Name="BossKeyRecoveryButton"
                Width="24"
                Height="24"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,8,8"
                Background="#10FFFFFF"
                BorderBrush="#20FFFFFF"
                BorderThickness="1"
                Opacity="0.3"
                IsTabStop="False"
                Click="BossKeyRecoveryButton_Click"
                Visibility="Collapsed">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18FFFFFF" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#28FFFFFF" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#30FFFFFF" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#30FFFFFF" />
            </Button.Resources>
        </Button>
    </Grid>
</Page>
