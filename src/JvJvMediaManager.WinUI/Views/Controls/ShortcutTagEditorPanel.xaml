<UserControl
    x:Class="JvJvMediaManager.Views.Controls.ShortcutTagEditorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:JvJvMediaManager.Views.Controls">

    <UserControl.Resources>
        <Style x:Key="ShortcutTagRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <DataTemplate x:Key="ShortcutTagRowTemplate"
                      x:DataType="controls:ShortcutTagRow">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>

                <TextBlock
                           Text="{x:Bind PositionLabel, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource MutedTextBrush}" />

                <FontIcon Grid.Column="1"
                          Glyph="&#xE700;"
                          FontSize="12"
                          FontFamily="Segoe MDL2 Assets"
                          Foreground="{ThemeResource MutedTextBrush}"
                          VerticalAlignment="Center" />

                <TextBox Grid.Column="2"
                         Text="{x:Bind Tag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="输入 Tag"
                         TextChanged="TagTextBox_TextChanged"
                         CanDrag="True"
                         AllowDrop="True"
                         DragStarting="TagTextBox_DragStarting"
                         DropCompleted="TagTextBox_DropCompleted"
                         DragOver="TagTextBox_DragOver"
                         Drop="TagTextBox_Drop"
                         Tag="{x:Bind}"
                         ToolTipService.ToolTip="拖动 Tag 调整位置"
                         Style="{StaticResource GlassTextBoxStyle}" />

                <Button Grid.Column="3"
                        Width="32"
                        Height="32"
                        Padding="6"
                        Background="Transparent"
                        BorderThickness="0"
                        Visibility="{x:Bind RemoveButtonVisibility, Mode=OneWay}"
                        Click="RemoveRowButton_Click"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="删除此行">
                    <FontIcon Glyph="&#xE711;"
                              FontSize="12"
                              FontFamily="Segoe MDL2 Assets" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid MinWidth="440" MaxHeight="560" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Width="32"
                    Height="32"
                    Padding="6"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BackButton_Click"
                    ToolTipService.ToolTip="返回设置">
                <FontIcon Glyph="&#xE72B;"
                          FontSize="14"
                          FontFamily="Segoe MDL2 Assets" />
            </Button>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="编辑快捷菜单"
                           Foreground="{ThemeResource TextBrush}"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="一个 Tag 一行，可拖动调整顺序。前 9 行对应小键盘数字键，后续行仅显示在快捷菜单中。"
                           Foreground="{ThemeResource MutedTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <ListView x:Name="ShortcutRowsList"
                  Grid.Row="1"
                  ItemsSource="{x:Bind Rows}"
                  ItemTemplate="{StaticResource ShortcutTagRowTemplate}"
                  ItemContainerStyle="{StaticResource ShortcutTagRowContainerStyle}"
                  SelectionMode="None"
                  Background="Transparent"
                  BorderThickness="0" />

        <Button x:Name="AddRowButton"
                Grid.Row="2"
                HorizontalAlignment="Left"
                Click="AddRowButton_Click"
                Style="{StaticResource SecondaryToolbarButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE710;"
                          FontSize="12"
                          FontFamily="Segoe MDL2 Assets" />
                <TextBlock Text="添加一行" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
