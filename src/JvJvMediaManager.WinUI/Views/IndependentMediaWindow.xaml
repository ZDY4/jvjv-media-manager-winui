<Window
    x:Class="JvJvMediaManager.Views.IndependentMediaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mainPage="using:JvJvMediaManager.Views.MainPageParts"
    Title="媒体播放器">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="SessionDragHeader"
                Background="#E6242424"
                CanDrag="True"
                DragStarting="SessionDragHeader_DragStarting"
                DropCompleted="SessionDragHeader_DropCompleted">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8A7;" FontSize="12" Foreground="#FFFF9F1C" />
                <TextBlock Text="拖动到主窗口右侧以停靠为分屏" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
            </StackPanel>
        </Border>
        <mainPage:PlayerPaneView x:Name="PlayerPane" Grid.Row="1" />

        <Button x:Name="BossKeyRecoveryButton"
                Width="24"
                Height="24"
                HorizontalAlignment="Right"
                Grid.Row="1"
                VerticalAlignment="Bottom"
                Margin="0,0,8,8"
                Background="#10FFFFFF"
                BorderBrush="#20FFFFFF"
                BorderThickness="1"
                Opacity="0.3"
                IsTabStop="False"
                Click="BossKeyRecoveryButton_Click"
                Visibility="Collapsed">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18FFFFFF" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#28FFFFFF" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#30FFFFFF" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#30FFFFFF" />
            </Button.Resources>
        </Button>
    </Grid>
</Window>
