<UserControl
    x:Class="JvJvMediaManager.Views.MainPageParts.VideoViewportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- Canvas does not clamp children to the viewport slot, so a 90/270
             rotated player can be laid out as the swapped rectangle and still
             paint the full frame after RenderTransform. -->
        <Canvas x:Name="VideoPlayerHost"
                x:FieldModifier="public">
            <MediaPlayerElement x:Name="VideoPlayer"
                                x:FieldModifier="public"
                                AreTransportControlsEnabled="False"
                                AutoPlay="True"
                                IsTabStop="False"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"
                                Stretch="Uniform" />
        </Canvas>

        <Border x:Name="VideoLoadingPreviewHost"
                x:FieldModifier="public"
                Background="{ThemeResource PlayerSurfaceBrush}"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Image x:Name="VideoLoadingPreviewImage"
                   x:FieldModifier="public"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />
        </Border>
    </Grid>
</UserControl>
