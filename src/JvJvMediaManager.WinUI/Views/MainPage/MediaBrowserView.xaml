<UserControl
    x:Class="JvJvMediaManager.Views.MainPageParts.MediaBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/MainPage/MediaLibraryResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <CollectionViewSource x:Key="ListGroupedMediaItemsSource"
                                  IsSourceGrouped="True"
                                  ItemsPath="VisibleItems" />
            <CollectionViewSource x:Key="GridGroupedMediaItemsSource"
                                  IsSourceGrouped="True"
                                  ItemsPath="VisibleItems" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          x:FieldModifier="public">
        <ListView x:Name="ListView"
                  x:FieldModifier="public"
                  AutomationProperties.AutomationId="MediaListView"
                  AutomationProperties.Name="媒体列表"
                  ItemsSource="{Binding Source={StaticResource ListGroupedMediaItemsSource}}"
                  Visibility="{Binding ListViewVisibility}"
                  Background="Transparent"
                  ItemContainerStyle="{StaticResource MediaListItemContainerStyle}"
                  ItemTemplate="{StaticResource ListItemTemplate}"
                  DataFetchSize="4"
                  IncrementalLoadingThreshold="3"
                  SelectionMode="Extended"
                  CanDragItems="True"
                  IsItemClickEnabled="False">
            <ListView.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource MediaFolderGroupHeaderTemplate}" />
            </ListView.GroupStyle>
        </ListView>

        <GridView x:Name="GridView"
                  x:FieldModifier="public"
                  AutomationProperties.AutomationId="MediaGridView"
                  AutomationProperties.Name="媒体网格"
                  ItemsSource="{Binding Source={StaticResource GridGroupedMediaItemsSource}}"
                  Tag="{Binding IconSize}"
                  Visibility="{Binding GridViewVisibility}"
                  Background="Transparent"
                  ItemContainerStyle="{StaticResource MediaGridItemContainerStyle}"
                  ItemTemplate="{StaticResource GridItemTemplate}"
                  DataFetchSize="5"
                  IncrementalLoadingThreshold="4"
                  SelectionMode="Extended"
                  CanDragItems="True"
                  IsItemClickEnabled="False">
            <GridView.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource MediaFolderGroupHeaderTemplate}" />
            </GridView.GroupStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"
                                   ItemWidth="140"
                                   ItemHeight="140" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>

        <Canvas x:Name="SelectionCanvas"
                x:FieldModifier="public"
                IsHitTestVisible="False">
            <Rectangle x:Name="SelectionRectangle"
                       x:FieldModifier="public"
                       Visibility="Collapsed"
                       RadiusX="4"
                       RadiusY="4"
                       Stroke="{ThemeResource LibrarySelectionStrongBrush}"
                       StrokeThickness="1.5"
                       Fill="{ThemeResource LibrarySelectionBrush}"
                       Opacity="0.45" />
        </Canvas>
    </Grid>
</UserControl>
