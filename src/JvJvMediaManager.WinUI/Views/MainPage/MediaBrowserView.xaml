<UserControl
    x:Class="JvJvMediaManager.Views.MainPageParts.MediaBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:JvJvMediaManager.ViewModels">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/MainPage/MediaLibraryResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="FolderSectionTemplate" x:DataType="viewModels:MediaFolderGroupViewModel">
                <StackPanel Spacing="6" Padding="0,0,0,8">
                    <ContentPresenter Content="{Binding}"
                                      ContentTemplate="{StaticResource MediaFolderGroupHeaderTemplate}"
                                      HorizontalAlignment="Stretch" />
                    <ItemsRepeater ItemsSource="{Binding VisibleItems}"
                                   ItemTemplate="{StaticResource GridItemTemplate}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Top"
                                   Tag="GroupItems">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout Orientation="Horizontal"
                                               MinItemWidth="140"
                                               MinItemHeight="140"
                                               MinRowSpacing="4"
                                               MinColumnSpacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          x:FieldModifier="public">
        <ScrollViewer x:Name="MediaScrollViewer"
                      x:FieldModifier="public"
                      Visibility="{Binding MediaBrowserVisibility}"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto"
                      ZoomMode="Disabled"
                      Background="Transparent">
            <ItemsRepeater x:Name="MediaRepeater"
                           x:FieldModifier="public"
                           ItemsSource="{Binding MediaFolderGroups}"
                           ItemTemplate="{StaticResource FolderSectionTemplate}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Grouped ListView/GridView fail-fast inside Microsoft.UI.Xaml.dll when a
             realized group changes. These hosts stay unbound so older controller
             hooks still have a control to attach to. The repeater above is the view. -->
        <ListView x:Name="ListView"
                  x:FieldModifier="public"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  SelectionMode="None" />
        <GridView x:Name="GridView"
                  x:FieldModifier="public"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  SelectionMode="None" />

        <Canvas x:Name="SelectionCanvas"
                x:FieldModifier="public"
                IsHitTestVisible="False">
            <Rectangle x:Name="SelectionRectangle"
                       x:FieldModifier="public"
                       Visibility="Collapsed"
                       RadiusX="4"
                       RadiusY="4"
                       Stroke="{ThemeResource LibrarySelectionStrongBrush}"
                       StrokeThickness="1.5"
                       Fill="{ThemeResource LibrarySelectionBrush}"
                       Opacity="0.45" />
        </Canvas>
    </Grid>
</UserControl>
