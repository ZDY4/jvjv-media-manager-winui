<UserControl
    x:Class="JvJvMediaManager.Views.MainPageParts.MediaBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JvJvMediaManager.Views.MainPageParts">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/MainPage/MediaLibraryResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="MediaTileRowTemplate" x:DataType="local:MediaTileRow">
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4" />
            </DataTemplate>
            <SolidColorBrush x:Key="StickyFolderBarBrush" Color="{ThemeResource SurfaceAltColor}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          x:FieldModifier="public">
        <ScrollViewer x:Name="MediaScrollViewer"
                      x:FieldModifier="public"
                      Visibility="{Binding MediaBrowserVisibility}"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto"
                      ZoomMode="Disabled"
                      Background="Transparent">
            <ItemsRepeater x:Name="MediaRepeater"
                           x:FieldModifier="public"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="2" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <Border x:Name="StickyFolderBar"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Visibility="Collapsed"
                Background="{StaticResource StickyFolderBarBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,7"
                IsHitTestVisible="True">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE8B7;"
                          FontSize="12"
                          Foreground="{ThemeResource MutedTextBrush}"
                          VerticalAlignment="Center" />
                <TextBlock x:Name="StickyFolderText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextBrush}"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Grouped ListView/GridView fail-fast inside Microsoft.UI.Xaml.dll when a
             realized group changes. These hosts stay unbound so older controller
             hooks still have a control to attach to. The repeater above is the view. -->
        <ListView x:Name="ListView"
                  x:FieldModifier="public"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  SelectionMode="None" />
        <GridView x:Name="GridView"
                  x:FieldModifier="public"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  SelectionMode="None" />

        <Canvas x:Name="SelectionCanvas"
                x:FieldModifier="public"
                IsHitTestVisible="False">
            <Rectangle x:Name="SelectionRectangle"
                       x:FieldModifier="public"
                       Visibility="Collapsed"
                       RadiusX="4"
                       RadiusY="4"
                       Stroke="{ThemeResource LibrarySelectionStrongBrush}"
                       StrokeThickness="1.5"
                       Fill="{ThemeResource LibrarySelectionBrush}"
                       Opacity="0.45" />
        </Canvas>
    </Grid>
</UserControl>
