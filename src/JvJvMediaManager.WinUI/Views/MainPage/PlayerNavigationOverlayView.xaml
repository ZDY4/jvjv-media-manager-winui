<UserControl
    x:Class="JvJvMediaManager.Views.MainPageParts.PlayerNavigationOverlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel x:Name="SideActionButtons"
                    x:FieldModifier="public"
                    Canvas.ZIndex="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,84"
                    Spacing="4">
            <Button x:Name="PlaybackModeButton"
                    x:FieldModifier="public"
                    AutomationProperties.AutomationId="PlaybackModeButton"
                    AutomationProperties.Name="播放模式"
                    Style="{StaticResource PanelIconButtonStyle}"
                    ToolTipService.ToolTip="播放模式">
                <FontIcon Glyph="&#xE8EE;" />
            </Button>
            <Button x:Name="FullScreenButton"
                    x:FieldModifier="public"
                    AutomationProperties.AutomationId="FullScreenButton"
                    AutomationProperties.Name="全屏"
                    Style="{StaticResource PanelIconButtonStyle}"
                    ToolTipService.ToolTip="全屏">
                <FontIcon Glyph="&#xE740;" />
            </Button>
            <Button x:Name="DeleteCurrentMediaButton"
                    x:FieldModifier="public"
                    AutomationProperties.AutomationId="DeleteCurrentMediaButton"
                    AutomationProperties.Name="移到回收站"
                    Style="{StaticResource PanelIconButtonStyle}"
                    ToolTipService.ToolTip="移到回收站">
                <FontIcon Glyph="&#xE74D;" />
            </Button>
        </StackPanel>

        <Border x:Name="PreviousMediaHotspot"
                x:FieldModifier="public"
                HorizontalAlignment="Left"
                Width="96"
                Background="Transparent"
                Visibility="Collapsed">
            <Grid>
                <Border x:Name="PreviousMediaCue"
                        x:FieldModifier="public"
                        Width="22"
                        Height="56"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{ThemeResource NavigationCueBrush}"
                        BorderThickness="0"
                        CornerRadius="{ThemeResource RadiusSmall}"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE76B;"
                              FontSize="12"
                              Foreground="{ThemeResource TextBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <Border x:Name="NextMediaHotspot"
                x:FieldModifier="public"
                HorizontalAlignment="Right"
                Width="96"
                Background="Transparent"
                Visibility="Collapsed">
            <Grid>
                <Border x:Name="NextMediaCue"
                        x:FieldModifier="public"
                        Width="22"
                        Height="56"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{ThemeResource NavigationCueBrush}"
                        BorderThickness="0"
                        CornerRadius="{ThemeResource RadiusSmall}"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE76C;"
                              FontSize="12"
                              Foreground="{ThemeResource TextBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
